# --- Environment-specific / secrets — never commit ---
wp-config.php
.env
.env.*

# --- Uploaded media — large binaries, syncs separately from code ---
wp-content/uploads/

# --- Caching, temp files, and DB export dumps ---
wp-content/cache/
wp-content/boost-cache/
wp-content/upgrade/
wp-content/backup*/
wp-content/ai1wm-backups/
wp-content/**/*.sql
*.log

# --- File Manager Advanced plugin storage — admin-uploaded files, not code ---
wp-content/plugins/file-manager-advanced/application/library/files/*
!wp-content/plugins/file-manager-advanced/application/library/files/.gitkeep

# --- Raw DB dumps sitting in the web root — never belong in git (also a live data-exposure risk) ---
mwp_db/
.st89ing/

# --- Large archived back-issue media — real content, kept on disk, not versioned in git ---
ssnd/*.pdf
markofexcellence/*.pdf
markofexcellence/*.mp3
wp-content/themes/universitytimes/markofexcellence2016/*.pdf

# --- Forensic/quarantine material — should never enter version control history ---
.sucuriquarantine/

# --- Debug/diagnostic scripts — never belong in a live web root ---
local-phpinfo.php

# --- Wordfence-generated data (firewall rules, attack logs, GeoIP DB, synced config) — not plugin code ---
wp-content/wflogs/
wp-content/plugins/wordfence/tmp/*
!wp-content/plugins/wordfence/tmp/.htaccess

# --- Query Monitor's db.php drop-in — a symlink baking in a server-specific absolute path, not portable code ---
wp-content/db.php

# --- Server/platform-generated content swept in by the fresh-baseline re-sync — not site code ---
# WP core's transient backup-before-update mechanism
wp-content/upgrade-temp-backup/
# GoDaddy platform infrastructure (mu-plugins and object-cache drop-in)
wp-content/mu-plugins/gd-system-plugin*
wp-content/mu-plugins/object-cache-pro*
wp-content/object-cache.php
# The deployer tool's own installation
git-deployer-app/
# Auto-generated thumbnail cache
.tmb/
# Root-owned, GoDaddy platform-managed
.user.ini
plat-cron.php

# --- OS and editor junk ---
.DS_Store
Thumbs.db

# --- Dependency directories, if you ever add build tooling ---
node_modules/
vendor/

# Local pre-fix scratch backups — never track
*.pre-fix-backup-*
*-BACKUP-*
*.bak
*.orig
